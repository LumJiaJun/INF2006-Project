# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file.

# Local dev default is SQLite (no value needed). For Docker Compose /
# production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://staysphere:staysphere_dev_only@db:5432/staysphere
DATABASE_URL=

# Generate a real random secret before deploying, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:8080

# --- AWS (only needed once deployed — see docs/DEPLOYMENT.md) ---
AWS_REGION=
# Do NOT put real access keys here in any committed file. On AWS,
# prefer an IAM role attached to the compute resource (EC2/ECS task
# role) instead of long-lived access keys. If you must run locally
# against AWS resources, use `aws configure` / a local credentials
# file, never a hardcoded key in this repo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
