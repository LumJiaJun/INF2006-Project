# Environment variable template. Placeholder values only.
# Copy to .env and fill in real values locally. NEVER commit real secrets.

# Application
APP_ENV=development
APP_PORT=8080

# Database / storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=changeme

# Cloud provider (do NOT commit real keys - use IAM roles / secret manager)
CLOUD_REGION=your-region
